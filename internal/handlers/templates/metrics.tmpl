<!DOCTYPE html>
<html>
<head>
    <title>Metrics Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .header p {
            opacity: 0.9;
            font-size: 1.1em;
        }

        .metrics-section {
            padding: 30px;
        }

        .section-title {
            font-size: 1.8em;
            color: #333;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #667eea;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .metric-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
            border-left: 4px solid #667eea;
        }

        .metric-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        .metric-card.counter {
            border-left-color: #ff6b6b;
        }

        .metric-name {
            font-size: 1.1em;
            color: #555;
            margin-bottom: 10px;
            word-break: break-all;
        }

        .metric-value {
            font-size: 2em;
            font-weight: bold;
            color: #333;
        }

        .metric-value.counter {
            color: #ff6b6b;
        }

        .metric-value.gauge {
            color: #667eea;
        }

        .empty-state {
            text-align: center;
            padding: 60px;
            color: #999;
            font-size: 1.2em;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .stats-bar {
            background: #f1f3f5;
            padding: 20px 30px;
            display: flex;
            justify-content: space-around;
            text-align: center;
            border-top: 1px solid #dee2e6;
        }

        .stat-item {
            flex: 1;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 1.5em;
            font-weight: bold;
            color: #333;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .metrics-grid {
                grid-template-columns: 1fr;
            }

            .stats-bar {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 Metrics Dashboard</h1>
            <p>Real-time metrics monitoring system</p>
        </div>

        <div class="metrics-section">
            <h2 class="section-title">📈 Gauge Metrics ({{len .Gauges}})</h2>
            {{if .Gauges}}
            <div class="metrics-grid">
                {{range $name, $value := .Gauges}}
                <div class="metric-card">
                    <div class="metric-name">{{$name}}</div>
                    <div class="metric-value gauge">{{printf "%.6f" $value}}</div>
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="empty-state">
                No gauge metrics available
            </div>
            {{end}}

            <h2 class="section-title">🔢 Counter Metrics ({{len .Counters}})</h2>
            {{if .Counters}}
            <div class="metrics-grid">
                {{range $name, $value := .Counters}}
                <div class="metric-card counter">
                    <div class="metric-name">{{$name}}</div>
                    <div class="metric-value counter">{{$value}}</div>
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="empty-state">
                No counter metrics available
            </div>
            {{end}}
        </div>

        <div class="stats-bar">
            <div class="stat-item">
                <div class="stat-label">Total Gauges</div>
                <div class="stat-value">{{len .Gauges}}</div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Total Counters</div>
                <div class="stat-value">{{len .Counters}}</div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Total Metrics</div>
                <div class="stat-value">{{add (len .Gauges) (len .Counters)}}</div>
            </div>
        </div>
    </div>
</body>
</html>